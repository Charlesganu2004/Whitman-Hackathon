# Phone API connection: replace with computer's LAN IPv4 address.
EXPO_PUBLIC_API_URL=http://192.168.1.100:3001
PORT=3001
# Server only. Leave keys empty for rubric practice. Never use EXPO_PUBLIC_ for keys.
AI_PROVIDER=groq
AI_SPEECH_PROVIDER=groq
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
GROQ_TRANSCRIPTION_MODEL=whisper-large-v3-turbo
# For OpenAI, change both provider values to openai.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
OPENAI_TRANSCRIPTION_MODEL=gpt-4o-mini-transcribe