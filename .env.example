# Copy this file to .env. The .env file is ignored by git, so keys stay on this computer.
PORT=3001
# Optional. In Expo Go the app finds this computer on its own. Set this only to force another address.
# EXPO_PUBLIC_API_URL=http://192.168.1.100:3001

# Server only. Leave every key empty for rubric practice. Never use EXPO_PUBLIC_ for keys.
# Free NVIDIA key from build.nvidia.com (starts with nvapi-). See docs/NVIDIA.md.
NVIDIA_API_KEY=
# Hosted NVIDIA model id. Nemotron 3 Super is the default.
NVIDIA_MODEL=nvidia/nemotron-3-super-120b-a12b

# Optional. NVIDIA cannot transcribe voice, so add one of these for recorded voice answers.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
GROQ_TRANSCRIPTION_MODEL=whisper-large-v3-turbo
# Jarvis speaks with a Groq voice when GROQ_API_KEY is set, and with the phone's own voice otherwise or on any error.
# Accept the model terms in the Groq console first. Input is limited to 200 characters per request, so long text is sent in pieces.
# GROQ_TTS_MODEL=canopylabs/orpheus-v1-english
# GROQ_TTS_VOICE=troy
# How Jarvis sounds: one vocal direction such as cheerful, excited, warm or friendly. Set it empty for a neutral read.
# GROQ_TTS_STYLE=cheerful
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
OPENAI_TRANSCRIPTION_MODEL=gpt-4o-mini-transcribe

# Optional. Unset, grading uses the first key present (Groq, then NVIDIA, then OpenAI) and voice uses Groq or OpenAI.
# AI_PROVIDER=nvidia
# AI_SPEECH_PROVIDER=groq
