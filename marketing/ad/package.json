{
  "name": "unscroll-ad",
  "version": "1.0.0",
  "private": true,
  "description": "Launch film for Unscroll, drawn in code with Remotion.",
  "scripts": {
    "studio": "remotion studio src/index.ts",
    "still": "remotion still src/index.ts",
    "render": "remotion render src/index.ts UnscrollAd out/unscroll-ad-4k.mp4 --scale=2 --codec=h264 --crf=16",
    "render:hd": "remotion render src/index.ts UnscrollAd out/unscroll-ad-1080p.mp4 --codec=h264 --crf=18",
    "typecheck": "tsc --noEmit",
    "audio": "node scripts/make-audio.mjs",
    "narration": "node --env-file=../../.env scripts/make-narration.mjs"
  },
  "dependencies": {
    "@remotion/cli": "4.0.534",
    "@remotion/google-fonts": "4.0.534",
    "@remotion/layout-utils": "4.0.534",
    "@remotion/noise": "4.0.534",
    "@remotion/paths": "4.0.534",
    "@remotion/transitions": "4.0.534",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "remotion": "4.0.534"
  },
  "devDependencies": {
    "@types/react": "~19.2.2",
    "typescript": "~6.0.3"
  }
}
