{
  "name": "interview-unlocked",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "main": "index.ts",
  "scripts": {
    "start": "expo start --go",
    "web": "expo start --web",
    "server": "node --env-file-if-exists=.env server/index.mjs",
    "check:environment": "node --env-file-if-exists=.env scripts/check-environment.mjs",
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-strip-types --test tests/*.test.mjs",
    "export:web": "expo export --platform web",
    "export:ios": "expo export --platform ios"
  },
  "dependencies": {
    "unpdf": "1.8.1",
    "expo": "57.0.27",
    "react": "19.2.3",
    "react-native": "0.86.3",
    "react-native-web": "0.21.2",
    "react-dom": "19.2.3",
    "expo-audio": "~57.0.5",
    "expo-document-picker": "~57.0.3",
    "expo-file-system": "~57.0.7",
    "expo-secure-store": "~57.0.4",
    "expo-sqlite": "~57.0.4",
    "expo-status-bar": "~57.0.1",
    "expo-speech": "~57.0.3",
    "expo-dev-client": "~57.0.19",
    "expo-modules-core": "~57.0.21",
    "react-native-safe-area-context": "~5.7.0"
  },
  "devDependencies": { "@types/react": "~19.2.2", "typescript": "~6.0.3" },
  "overrides": { "uuid": "11.1.1" }
}
